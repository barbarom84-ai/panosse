<Window x:Class="Panosse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panosse" 
        Height="550" 
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assets/panosse.png"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Animation de pulsation -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Style pour le bouton circulaire bleu -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ellipse" Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" Color="#2196F3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ellipse" Property="Fill" Value="#42A5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ellipse" Property="Fill" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ellipse" Property="Fill" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour le bouton Quitter -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="15"
                                Width="30" Height="30">
                            <TextBlock Text="×" 
                                       FontSize="24" 
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Margin="0,-3,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                                <Setter Property="Foreground" Value="#F44336"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les boutons de contrôle de fenêtre -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour la barre de progression -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Barre de menu -->
        <Menu x:Name="MainMenu"
              Background="White"
              VerticalAlignment="Top"
              Height="34"
              PreviewMouseLeftButtonDown="MainMenu_PreviewMouseLeftButtonDown"
              Panel.ZIndex="10"
              Margin="0,0,74,0"
              BorderThickness="0,0,0,1"
              BorderBrush="#E0E0E0">
            <Menu.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" Color="Black"/>
            </Menu.Effect>
            
            <!-- Menu Fichier -->
            <MenuItem Header="📁 _Fichier" FontSize="12" Padding="10,5">
                <MenuItem Header="🔄 _Actualiser la détection" Command="{Binding RefreshDetectionCommand}" />
                <Separator />
                <MenuItem Header="🗕 _Réduire dans la barre des tâches" Command="{Binding MinimizeToTrayCommand}" InputGestureText="Échap"/>
                <MenuItem Header="❌ _Quitter définitivement" Command="{Binding QuitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <!-- Menu Outils -->
            <MenuItem Header="🔧 _Outils" FontSize="12" Padding="10,5">
                <MenuItem Header="⚙️ _Paramètres" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="🔍 _Vérifier les mises à jour" Command="{Binding CheckUpdatesCommand}" />
                <Separator />
                <MenuItem Header="🌐 _Ouvrir le dépôt GitHub" Command="{Binding OpenGitHubCommand}" />
            </MenuItem>
            
            <!-- Menu Aide -->
            <MenuItem Header="❓ _Aide" FontSize="12" Padding="10,5">
                <MenuItem Header="ℹ️ _À propos de Panosse" Command="{Binding OpenAboutCommand}" InputGestureText="F1"/>
            </MenuItem>
        </Menu>
        
        <!-- Barre de notification de mise à jour -->
        <Border x:Name="UpdateBar"
                Background="#4CAF50"
                Height="40"
                VerticalAlignment="Top"
                Margin="0,30,0,0"
                Panel.ZIndex="9"
                Visibility="Collapsed"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="-40"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <Grid Margin="15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icône et message -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpdateMessage"
                                   Text="{Binding UpdateMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Bouton Mettre à jour -->
                    <Button x:Name="BtnMettreAJour"
                            Grid.Column="1"
                            Content="Mettre à jour"
                            Command="{Binding InstallUpdateCommand}"
                            Background="White"
                            Foreground="#4CAF50"
                            BorderThickness="0"
                            Padding="15,5"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Bouton fermer -->
                    <Button x:Name="BtnFermerUpdate"
                            Grid.Column="2"
                            Content="×"
                            Command="{Binding CloseUpdateBarCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="20"
                            FontWeight="Bold"
                            Width="25"
                            Height="25"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="0,-3,0,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#388E3C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <!-- Barre de progression du téléchargement -->
                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Row="1"
                             Height="3"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding DownloadProgressValue}"
                             Visibility="{Binding DownloadProgressVisibility}"
                             Margin="0,5,0,0"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Contrôles fenêtre en haut à droite -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,3,5,0"
                    Panel.ZIndex="12">
            <Button x:Name="BtnMinimizeTray"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Content="—"
                    FontSize="18"
                    Command="{Binding MinimizeToTrayCommand}"
                    ToolTip="Réduire dans la barre des tâches"/>
            <Button x:Name="BtnCloseApp"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Content="×"
                    Command="{Binding QuitCommand}"
                    ToolTip="Quitter définitivement"/>
        </StackPanel>

        <!-- Titre -->
        <TextBlock Text="Panosse" 
                   FontSize="36" 
                   FontWeight="Light" 
                   Foreground="#424242" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   Margin="0,60,0,0"/>

        <!-- Zone centrale -->
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="0,-30,0,0">
            
            <!-- Bouton circulaire avec icône -->
            <Button x:Name="BtnNettoyer" 
                    Style="{StaticResource CircleButtonStyle}" 
                    Width="150" 
                    Height="150"
                    Command="{Binding CleanCommand}"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Grid>
                    <!-- Image panosse.png -->
                    <Image Source="pack://application:,,,/assets/panosse.png" 
                           Width="80" 
                           Height="80"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Button>

            <!-- Texte sous le bouton -->
            <TextBlock x:Name="BtnText"
                       Text="{Binding ButtonText}" 
                       FontSize="18" 
                       FontWeight="SemiBold"
                       Foreground="#424242" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,0"/>
        </StackPanel>

        <!-- Zone de statut en bas -->
        <StackPanel VerticalAlignment="Bottom" Margin="30,0,30,30">
            <!-- Barre de progression -->
            <ProgressBar x:Name="PrgBar" 
                         Style="{StaticResource ModernProgressBar}"
                         Minimum="0" 
                         Maximum="100" 
                         Value="{Binding ProgressValue}" 
                         Visibility="{Binding ProgressVisibility}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Foreground="{Binding ProgressForeground}"
                         Margin="0,0,0,10"/>

            <!-- Liste des tâches -->
            <ScrollViewer x:Name="TaskScrollViewer"
                          MaxHeight="100"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Opacity="0"
                          Margin="0,0,0,10">
                <ItemsControl x:Name="TaskList"
                              ItemsSource="{Binding TaskMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       FontSize="11" 
                                       Foreground="#9E9E9E"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,1"
                                       Opacity="0.9"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Message de statut -->
            <TextBlock x:Name="StatusText" 
                       Text="{Binding StatusText}" 
                       FontSize="14" 
                       Foreground="{Binding StatusForeground}" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       MouseLeftButtonDown="StatusText_MouseLeftButtonDown"
                       Cursor="Arrow"/>
        </StackPanel>

        <!-- Overlay "À propos" -->
        <Grid x:Name="OverlayAPropos"
              Background="#CC000000"
              Visibility="Collapsed"
              Opacity="0"
              MouseLeftButtonDown="OverlayAPropos_MouseDown">
            
            <!-- Panneau À propos -->
            <Border Background="White"
                    CornerRadius="15"
                    Width="320"
                    MaxHeight="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24,20,24,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="440">
                <StackPanel>
                    <!-- Logo et nom -->
                    <Image Source="pack://application:,,,/assets/panosse.png"
                           Width="60"
                           Height="60"
                           Margin="0,0,0,15"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    
                    <TextBlock Text="Panosse"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2196F3"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    
                    <!-- Version centrée -->
                    <TextBlock x:Name="VersionText"
                               Text="{Binding VersionText}"
                               FontSize="14"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    
                    <!-- Bouton Vérifier les mises à jour avec largeur fixe -->
                    <Button x:Name="BtnRechercherMAJ"
                            Content="{Binding CheckUpdatesButtonText}"
                            Command="{Binding CheckUpdatesCommand}"
                            Background="{Binding CheckUpdatesButtonBackground}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="12,8"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Width="200"
                            Margin="0,0,0,12"
                            IsEnabled="{Binding IsCheckUpdatesButtonEnabled}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          FontSize="{TemplateBinding FontSize}"
                                                          FontWeight="{TemplateBinding FontWeight}"
                                                          TextAlignment="Center"
                                                          TextWrapping="Wrap"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#66BB6A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#388E3C"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding LastUpdateCheckText}"
                               FontSize="11"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    
                    <!-- Slogan -->
                    <TextBlock Text="La serpillère numérique"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#424242"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    
                    <TextBlock Text="pour un PC tout propre"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#424242"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    
                    <!-- Séparateur -->
                    <Border Height="1"
                            Background="#E0E0E0"
                            Margin="0,0,0,15"/>
                    
                    <!-- Développeur -->
                    <TextBlock Text="Développé par"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    
                    <TextBlock Text="Marco Barbaro"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#424242"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    
                    <!-- Lien GitHub -->
                    <TextBlock x:Name="LinkGitHub"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20">
                        <Hyperlink NavigateUri="https://github.com/barbarom84-ai/panosse"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="#2196F3"
                                   TextDecorations="None">
                            <Run Text="🔗 GitHub"/>
                        </Hyperlink>
                    </TextBlock>
                    
                    <!-- Bouton Retour -->
                    <Button Content="Retour"
                            Command="{Binding CloseAboutCommand}"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="30,10"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#42A5F5"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Overlay Paramètres -->
        <Grid x:Name="OverlaySettings"
              Background="#CC000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="OverlaySettings_MouseDown">

            <Border Background="White"
                    CornerRadius="15"
                    Width="340"
                    MaxHeight="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24,22,24,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="⚙️ Paramètres"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#2196F3"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18"/>

                    <Border Height="1" Background="#E0E0E0" Margin="0,0,0,16"/>

                    <CheckBox Content="Vérifier les mises à jour au démarrage"
                              IsChecked="{Binding CheckUpdatesOnStartup}"
                              FontSize="13"
                              Foreground="#424242"
                              Margin="0,0,0,12"/>

                    <CheckBox Content="Jouer le son de réussite"
                              IsChecked="{Binding PlaySuccessSound}"
                              FontSize="13"
                              Foreground="#424242"
                              Margin="0,0,0,12"/>

                    <CheckBox Content="Afficher les notifications dans la barre des tâches"
                              IsChecked="{Binding ShowTrayNotifications}"
                              FontSize="13"
                              Foreground="#424242"
                              Margin="0,0,0,18"/>

                    <TextBlock Text="Ces préférences sont sauvegardées automatiquement."
                               FontSize="11"
                               Foreground="#9E9E9E"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Annuler"
                                Command="{Binding CloseSettingsCommand}"
                                Background="#EEEEEE"
                                Foreground="#616161"
                                BorderThickness="0"
                                Padding="18,8"
                                FontSize="13"
                                Margin="0,0,10,0"
                                Cursor="Hand"/>

                        <Button Content="Enregistrer"
                                Command="{Binding SaveSettingsCommand}"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="18,8"
                                FontSize="13"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
