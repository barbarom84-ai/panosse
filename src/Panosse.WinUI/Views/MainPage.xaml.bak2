<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Panosse.WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Panosse.WinUI"
    xmlns:sys="using:System"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Style pour le bouton circulaire bleu -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ellipse" Fill="{TemplateBinding Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#F5F5F5" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de menu -->
        <MenuBar Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuBarItem Title="Fichier">
                <MenuFlyoutItem Text="Quitter définitivement" Click="MenuQuit_Click" />
            </MenuBarItem>
            
            <MenuBarItem Title="Outils">
                <MenuFlyoutItem Text="Paramètres" Click="MenuSettings_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Historique des opérations" Command="{x:Bind ViewModel.RefreshHistoryCommand}" Click="MenuHistory_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Vérifier les mises à jour" Command="{x:Bind ViewModel.CheckUpdatesCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Ouvrir les logs" Command="{x:Bind ViewModel.OpenLogsCommand}" />
            </MenuBarItem>
            
            <MenuBarItem Title="Aide">
                <MenuFlyoutItem Text="À propos de Panosse" Click="MenuAbout_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Titre et Zone centrale -->
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                
                <!-- Titre -->
                <TextBlock Text="Panosse" 
                           FontSize="42" 
                           FontWeight="Light" 
                           Foreground="#424242" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- Bouton circulaire avec icône -->
                <Button x:Name="BtnNettoyer" 
                        Style="{StaticResource CircleButtonStyle}" 
                        Width="180" 
                        Height="180"
                        Command="{x:Bind ViewModel.RunCleanupCommand}">
                    <Button.Content>
                        <Image Source="ms-appx:///Assets/panosse.png" 
                               Width="100" 
                               Height="100"
                               Stretch="Uniform"/>
                    </Button.Content>
                </Button>

                <!-- Texte sous le bouton -->
                <TextBlock Text="{x:Bind ViewModel.ButtonText, Mode=OneWay}" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="#424242" 
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Zone de statut en bas -->
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="30,0,30,30" Spacing="10">
            <!-- Barre de progression -->
            <ProgressBar Minimum="0" 
                         Maximum="100" 
                         Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" 
                         Height="6"
                         Foreground="#2196F3"
                         Background="#E0E0E0"/>

            <!-- Message de statut -->
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                       FontSize="14" 
                       Foreground="#757575" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
                       
            <!-- Avertissement Navigateurs -->
            <TextBlock x:Name="BrowserWarningText"
                       Text="⚠️ Veuillez fermer Edge pour un nettoyage complet (cliquez ici pour fermer automatiquement)"
                       FontSize="14"
                       Foreground="#FFA000"
                       TextAlignment="Center"
                       TextDecorations="Underline"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Tapped="BrowserWarningText_Tapped"
                       Cursor="Hand" />
        </StackPanel>

        <!-- Overlay Paramètres -->
        <Grid x:Name="OverlaySettings" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="15" Width="400" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="⚙️ Paramètres" FontSize="24" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" />
                    <Border Height="1" Background="#E0E0E0" />
                    
                    <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <ToggleSwitch Header="Mode prévisualisation" IsOn="{x:Bind ViewModel.PreviewModeEnabled, Mode=TwoWay}" />
                            <TextBox Header="Exclusions (patterns)" Text="{x:Bind ViewModel.ExclusionPatterns, Mode=TwoWay}" PlaceholderText="ex: setup, iso, games" />
                            <ToggleSwitch Header="Activer nettoyage planifié" IsOn="{x:Bind ViewModel.EnableScheduledCleanup, Mode=TwoWay}" />
                            <!-- Removed x:Bind for int property to avoid compile error -->
                            <TextBox Header="Intervalle planifié (heures)" Text="24" />
                        </StackPanel>
                    </ScrollViewer>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="Fermer" Click="CloseSettings_Click" />
                        <Button Content="Sauvegarder" Command="{x:Bind ViewModel.SaveSettingsCommand}" Style="{StaticResource AccentButtonStyle}" Click="CloseSettings_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Overlay Historique -->
        <Grid x:Name="OverlayHistory" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="15" Width="500" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="🕘 Historique" FontSize="24" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" />
                    <Border Height="1" Background="#E0E0E0" />
                    
                    <ListView ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}" MaxHeight="400" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <Button Content="Fermer" Click="CloseHistory_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Overlay À propos -->
        <Grid x:Name="OverlayAbout" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="15" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/panosse.png" Width="80" Height="80" />
                    <TextBlock Text="Panosse" FontSize="28" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" />
                    <TextBlock Text="La serpillère numérique pour un PC tout propre" FontSize="14" Foreground="#424242" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Développé par Marco Barbaro" FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center" />
                    <Button Content="Fermer" Click="CloseAbout_Click" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>