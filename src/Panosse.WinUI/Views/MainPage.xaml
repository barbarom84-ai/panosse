<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Panosse.WinUI.Views.MainPage"
    RequestedTheme="Light"
    KeyDown="MainPage_KeyDown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Panosse.WinUI"
    xmlns:converters="using:Panosse.WinUI.Converters"
    xmlns:sys="using:System"
    xmlns:vm="using:Panosse.Core.ViewModels"
    xmlns:services="using:Panosse.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Couleurs globales -->
        <SolidColorBrush x:Key="AppPrimaryColor" Color="#2196F3" />
        <SolidColorBrush x:Key="AppPrimaryHoverColor" Color="#42A5F5" />
        <SolidColorBrush x:Key="AppPrimaryPressedColor" Color="#1976D2" />
        <SolidColorBrush x:Key="AppTextColor" Color="#424242" />
        <SolidColorBrush x:Key="AppSubtextColor" Color="#757575" />
        <SolidColorBrush x:Key="AppBorderColor" Color="#E0E0E0" />
        <SolidColorBrush x:Key="AppBackgroundColor" Color="#F3F6FB" />
        <SolidColorBrush x:Key="AppCardColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppWarningColor" Color="#FFA000" />
        <SolidColorBrush x:Key="AppSuccessColor" Color="#4CAF50" />
        <SolidColorBrush x:Key="AppSuccessHoverColor" Color="#66BB6A" />
        <SolidColorBrush x:Key="AppSuccessPressedColor" Color="#388E3C" />
        <SolidColorBrush x:Key="AppMutedTextColor" Color="#616161" />
        <SolidColorBrush x:Key="AppSuccessStatusColor" Color="#2E7D32" />
        <SolidColorBrush x:Key="AppSidebarColor" Color="#EAF1FB" />
        <SolidColorBrush x:Key="AppSidebarSelectedColor" Color="#D6E6FB" />

        <!-- Animation serpillère : lancée pendant le nettoyage (léger balancement + petit rebond) -->
        <Storyboard x:Name="MopCleaningStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="MopTransform"
                             Storyboard.TargetProperty="Rotation"
                             From="-14" To="14" Duration="0:0:0.55"
                             EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MopTransform"
                             Storyboard.TargetProperty="TranslateY"
                             From="0" To="-6" Duration="0:0:0.55"
                             EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Style carte Fluent -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppCardColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,20" />
        </Style>

        <!-- CTA circulaire de la carte Boost : template custom sans chrome carré.
             Le contenu (Ellipse+ImageBrush) est rogné dans un disque parfait :
             aucun coin carré/arrondi du PNG ne dépasse, et aucun fond carré du bouton. -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <!-- Le contenu est lui-même une Ellipse : silhouette 100% ronde -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Padding="0"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les boutons secondaires (Fermer, etc.) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Style pour les boutons d'action principale (Sauvegarder, etc.) -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppPrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Suppression de pilotes : action destructive, mise en avant en rouge -->
        <SolidColorBrush x:Key="AppDangerColor" Color="#D32F2F" />
        <SolidColorBrush x:Key="AppDangerSoftColor" Color="#FDECEA" />
        <Style x:Key="DangerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppDangerColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="RowDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftColor}"/>
            <Setter Property="Foreground" Value="{StaticResource AppDangerColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style vert pour le bouton de vérification des mises à jour (À propos) -->
        <Style x:Key="AboutUpdateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppSuccessColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Style d'item de navigation (sidebar) -->
        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource AppTextColor}" />
        </Style>

        <Style x:Key="NavTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Page Pilotes -->
        <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextColor}" />
        </Style>
        <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource AppSubtextColor}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextColor}" />
        </Style>
        <Style x:Key="ItemTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextColor}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="ItemDetailTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AppSubtextColor}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppSidebarSelectedColor}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryPressedColor}" />
        </Style>
        <Style x:Key="RiskTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextColor}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="NoticeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8E1" />
            <Setter Property="BorderBrush" Value="{StaticResource AppWarningColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="ItemCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:TaskMessageBrushConverter x:Key="TaskMessageBrushConverter" />
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar de navigation -->
        <Grid Grid.Column="0" Background="{StaticResource AppSidebarColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,20,16,16">
                <Image Source="ms-appx:///Assets/panosse.png" Width="32" Height="32" />
                <TextBlock Text="Panosse"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppTextColor}" />
            </StackPanel>

            <ListView x:Name="NavList"
                      Grid.Row="1"
                      SelectionMode="Single"
                      SelectionChanged="NavList_SelectionChanged"
                      ItemContainerStyle="{StaticResource NavItemStyle}">
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Accueil" Style="{StaticResource NavTextStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Pilotes" Style="{StaticResource NavTextStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Paramètres" Style="{StaticResource NavTextStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Historique" Style="{StaticResource NavTextStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Diagnostics" Style="{StaticResource NavTextStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="À propos" Style="{StaticResource NavTextStyle}" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <Button Grid.Row="2"
                    Click="MenuQuit_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="16,8,16,20">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="Quitter" Style="{StaticResource NavTextStyle}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Zone de contenu -->
        <Grid Grid.Column="1" Margin="0">

            <!-- ============ ACCUEIL ============ -->
            <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Stretch">

                    <!-- Carte Boost (dominante) -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="28,26">
                        <StackPanel Spacing="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Text="Passer la panosse"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextColor}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Text="Nettoyez les fichiers temporaires et libérez de l'espace en un clic."
                                           FontSize="14"
                                           Foreground="{StaticResource AppSubtextColor}"
                                           TextWrapping="WrapWholeWords"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           MaxWidth="360" />
                                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="Profil de nettoyage"
                                               FontSize="13"
                                               Foreground="{StaticResource AppSubtextColor}"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Width="220"
                                              HorizontalAlignment="Center"
                                              SelectedIndex="{x:Bind ViewModel.CleanupProfileIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Rapide" />
                                        <ComboBoxItem Content="Standard" />
                                        <ComboBoxItem Content="Profond" />
                                    </ComboBox>
                                    <TextBlock Text="{x:Bind ViewModel.CleanupProfileDescription, Mode=OneWay}"
                                               FontSize="13"
                                               Foreground="{StaticResource AppMutedTextColor}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               MaxWidth="360" />
                                </StackPanel>
                                <Button x:Name="BtnNettoyer"
                                        Style="{StaticResource CircleButtonStyle}"
                                        Command="{x:Bind ViewModel.RunCleanupCommand}"
                                        AutomationProperties.Name="{x:Bind ViewModel.ButtonText, Mode=OneWay}"
                                        AutomationProperties.HelpText="Lance le nettoyage selon le profil sélectionné"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ButtonText, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                    <!-- Ellipse + ImageBrush : cercle parfait, PNG (coins transparents) remplit le disque -->
                                    <Ellipse x:Name="MopIcon"
                                             Width="88"
                                             Height="88"
                                             RenderTransformOrigin="0.5,0.9">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="ms-appx:///Assets/panosse.png"
                                                        Stretch="UniformToFill"
                                                        AlignmentX="Center"
                                                        AlignmentY="Center" />
                                        </Ellipse.Fill>
                                        <Ellipse.RenderTransform>
                                            <CompositeTransform x:Name="MopTransform" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Button>
                                <HyperlinkButton Content="Aperçu du nettoyage"
                                                 Command="{x:Bind ViewModel.RunPreviewCommand}"
                                                 HorizontalAlignment="Center"
                                                 FontSize="14"
                                                 AutomationProperties.Name="Aperçu du nettoyage" />
                            </StackPanel>

                            <!-- Avertissement Navigateurs -->
                            <HyperlinkButton x:Name="BrowserWarningLink"
                                             Visibility="Collapsed"
                                             Click="BrowserWarningLink_Click"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             MaxWidth="520">
                                <TextBlock Text="⚠️ Veuillez fermer Edge pour un nettoyage complet (cliquez ici pour fermer automatiquement)"
                                           Foreground="{StaticResource AppWarningColor}"
                                           FontSize="14"
                                           TextWrapping="WrapWholeWords"
                                           TextAlignment="Center"
                                           TextDecorations="Underline" />
                            </HyperlinkButton>
                        </StackPanel>
                    </Border>

                    <!-- Carte aperçu (estimations par catégorie) -->
                    <Border x:Name="PreviewCard"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="24,16"
                            VerticalAlignment="Top"
                            x:Load="{x:Bind ViewModel.HasPreviewResults, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Aperçu"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}" />
                            <TextBlock Text="{x:Bind ViewModel.PreviewRiskSummary, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource AppWarningColor}"
                                       TextWrapping="WrapWholeWords" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <TextBlock Text="{x:Bind}"
                                                   Foreground="{StaticResource AppTextColor}"
                                                   FontSize="14"
                                                   TextWrapping="WrapWholeWords"
                                                   Margin="0,2,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Lancer le nettoyage"
                                    Command="{x:Bind ViewModel.ConfirmCleanupFromPreviewCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Carte espace à gérer manuellement (mesuré, jamais supprimé) -->
                    <Border x:Name="StorageReportCard"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="24,16"
                            VerticalAlignment="Top"
                            x:Load="{x:Bind ViewModel.HasStorageReport, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Espace à gérer manuellement"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Panosse ne supprime pas ces éléments (modèles, disques virtuels, réglages système) : voici comment récupérer la place si vous n'en avez plus besoin."
                                       Style="{StaticResource ItemDetailTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.StorageReportItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:StorageReportItem">
                                        <StackPanel Spacing="2" Margin="0,6,0,6">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource ItemTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind Advice}"
                                                       Style="{StaticResource ItemDetailTextStyle}"
                                                       IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Carte activité (progression + étapes) -->
                    <Border x:Name="ActivityCard"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="24,16"
                            VerticalAlignment="Top"
                            x:Load="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Activité"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}" />
                            <ProgressBar x:Name="CleanupProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                         Height="6"
                                         Foreground="{StaticResource AppPrimaryColor}"
                                         Background="{StaticResource AppBorderColor}"
                                         CornerRadius="3"
                                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="Annuler"
                                    Command="{x:Bind ViewModel.CancelCleanupCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ItemsControl x:Name="TaskMessagesList"
                                          ItemsSource="{x:Bind ViewModel.TaskMessages, Mode=OneWay}"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <TextBlock Text="{x:Bind}"
                                                   Foreground="{Binding Converter={StaticResource TaskMessageBrushConverter}}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="WrapWholeWords"
                                                   Margin="0,2,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Carte résumé / statut -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="24,16"
                            VerticalAlignment="Top">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Résumé"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppSuccessStatusColor}"
                                       TextWrapping="WrapWholeWords"
                                       Visibility="{x:Bind ViewModel.IsSuccessStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{StaticResource AppSubtextColor}"
                                       TextWrapping="WrapWholeWords"
                                       Visibility="{x:Bind ViewModel.IsSuccessStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PILOTES ============ -->
            <ScrollViewer x:Name="DriversPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="860">
                    <TextBlock Text="Pilotes" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Repère les anciennes versions de pilotes remplacées, les pilotes que plus aucun périphérique n'utilise et les périphériques cachés débranchés depuis longtemps."
                               Style="{StaticResource PageSubtitleTextStyle}" />

                    <Border Style="{StaticResource NoticeBorderStyle}"
                            Visibility="{x:Bind DriversViewModel.ShowElevationNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Supprimer des pilotes demande les droits administrateur. Pas d'inquiétude : en cliquant sur « Supprimer », Panosse les demande à Windows puis termine la suppression tout seul."
                                       Style="{StaticResource ItemDetailTextStyle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Relancer en administrateur"
                                    Command="{x:Bind DriversViewModel.RestartAsAdminCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Analyser les pilotes"
                                        Command="{x:Bind DriversViewModel.ScanCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="Périphériques absents depuis plus de"
                                           Style="{StaticResource ItemDetailTextStyle}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2"
                                          SelectedIndex="{x:Bind DriversViewModel.MinimumAgeIndex, Mode=TwoWay}"
                                          MinWidth="130"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="30 jours" />
                                    <ComboBoxItem Content="90 jours" />
                                    <ComboBoxItem Content="6 mois" />
                                    <ComboBoxItem Content="1 an" />
                                </ComboBox>
                            </Grid>
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind DriversViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind DriversViewModel.StatusText, Mode=OneWay}"
                                       Style="{StaticResource ItemDetailTextStyle}" />
                            <TextBlock Text="{x:Bind DriversViewModel.SummaryText, Mode=OneWay}"
                                       Style="{StaticResource ItemTitleTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Visibility="{x:Bind DriversViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="10">
                            <Button Content="{x:Bind DriversViewModel.DeleteSelectedText, Mode=OneWay}"
                                    Command="{x:Bind DriversViewModel.CleanSelectedCommand}"
                                    Style="{StaticResource DangerActionButtonStyle}" />
                            <TextBlock Text="{x:Bind DriversViewModel.DeleteHintText}"
                                       Style="{StaticResource ItemDetailTextStyle}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DriversViewModel.SelectionText, Mode=OneWay}"
                                           Style="{StaticResource ItemDetailTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Sélection recommandée"
                                            Command="{x:Bind DriversViewModel.SelectRecommendedCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="Tout désélectionner"
                                            Command="{x:Bind DriversViewModel.SelectNoneCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <ListView ItemsSource="{x:Bind DriversViewModel.Items}"
                                      SelectionMode="None"
                                      MaxHeight="360"
                                      HorizontalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DriverIssueItem">
                                        <Grid ColumnSpacing="10" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource ItemCheckBoxStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource ItemTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource ItemDetailTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <Border Style="{StaticResource BadgeBorderStyle}">
                                                    <TextBlock Text="{x:Bind KindLabel}" Style="{StaticResource BadgeTextStyle}" />
                                                </Border>
                                                <TextBlock Text="{x:Bind RiskLabel}" Style="{StaticResource RiskTextStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="3"
                                                    Content="🗑️ Supprimer"
                                                    Command="{x:Bind DeleteCommand}"
                                                    ToolTipService.ToolTip="Supprimer uniquement cet élément"
                                                    Style="{StaticResource RowDeleteButtonStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Sauvegardes des pilotes" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind DriversViewModel.BackupStatus, Mode=OneWay}"
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Restaurer la dernière sauvegarde"
                                        Command="{x:Bind DriversViewModel.RestoreLatestBackupCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                <Button Content="Ouvrir le dossier"
                                        Command="{x:Bind DriversViewModel.OpenBackupsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PARAMÈTRES ============ -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="860">
                    <TextBlock Text="Paramètres"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextColor}" />

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <CheckBox Content="Vérifier les mises à jour au démarrage"
                                      IsChecked="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}"
                                      FontSize="14"
                                      Foreground="{StaticResource AppTextColor}" />
                            <CheckBox Content="Jouer le son de réussite"
                                      IsChecked="{x:Bind ViewModel.PlaySuccessSound, Mode=TwoWay}"
                                      FontSize="14"
                                      Foreground="{StaticResource AppTextColor}" />
                            <CheckBox Content="Afficher les notifications dans la barre des tâches"
                                      IsChecked="{x:Bind ViewModel.ShowTrayNotifications, Mode=TwoWay}"
                                      FontSize="14"
                                      Foreground="{StaticResource AppTextColor}" />
                            <CheckBox Content="Activer le mode prévisualisation (sans suppression)"
                                      IsChecked="{x:Bind ViewModel.PreviewModeEnabled, Mode=TwoWay}"
                                      FontSize="14"
                                      Foreground="{StaticResource AppTextColor}" />

                            <TextBlock Text="Échelle de l'interface"
                                       FontSize="13"
                                       Foreground="{StaticResource AppSubtextColor}" />
                            <ComboBox Width="220"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="{x:Bind ViewModel.UiScaleIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Échelle de l'interface">
                                <ComboBoxItem Content="100 %" />
                                <ComboBoxItem Content="110 %" />
                                <ComboBoxItem Content="125 %" />
                            </ComboBox>

                            <TextBlock Text="Exclusions intelligentes (mots-clés, séparés par virgules)"
                                       FontSize="13"
                                       Foreground="{StaticResource AppSubtextColor}" />
                            <TextBox Foreground="{StaticResource AppTextColor}"
                                     Background="{StaticResource AppCardColor}"
                                     BorderBrush="{StaticResource AppBorderColor}"
                                     BorderThickness="1"
                                     FontSize="14"
                                     MinHeight="32"
                                     Padding="10,6"
                                     Text="{x:Bind ViewModel.ExclusionPatterns, Mode=TwoWay}"
                                     PlaceholderText="ex: setup, iso, games" />

                            <CheckBox Content="Activer le nettoyage planifié"
                                      IsChecked="{x:Bind ViewModel.EnableScheduledCleanup, Mode=TwoWay}"
                                      FontSize="14"
                                      Foreground="{StaticResource AppTextColor}" />

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Intervalle (heures):"
                                           FontSize="14"
                                           Foreground="{StaticResource AppSubtextColor}"
                                           VerticalAlignment="Center" />
                                <TextBox Width="72"
                                         MinHeight="30"
                                         Padding="8,4"
                                         FontSize="14"
                                         Foreground="{StaticResource AppTextColor}"
                                         Background="{StaticResource AppCardColor}"
                                         BorderBrush="{StaticResource AppBorderColor}"
                                         BorderThickness="1"
                                         Text="{x:Bind ViewModel.ScheduledCleanupIntervalHoursText, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.SchedulerStatusText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource AppMutedTextColor}"
                                       TextWrapping="WrapWholeWords" />

                            <TextBlock Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource AppMutedTextColor}"
                                       TextWrapping="WrapWholeWords" />

                            <TextBlock Text="Ces préférences sont sauvegardées automatiquement."
                                       FontSize="13"
                                       Foreground="{StaticResource AppMutedTextColor}"
                                       TextWrapping="WrapWholeWords" />

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button Content="Enregistrer"
                                        Command="{x:Bind ViewModel.SaveSettingsCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ HISTORIQUE ============ -->
            <ScrollViewer x:Name="HistoryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="860">
                    <TextBlock Text="Historique"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextColor}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Ouvrir les logs"
                                Command="{x:Bind ViewModel.OpenLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Exporter"
                                Command="{x:Bind ViewModel.ExportHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Effacer l'historique"
                                Command="{x:Bind ViewModel.ClearHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <ListView ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="440"
                                  HorizontalAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{x:Bind}"
                                               Foreground="{StaticResource AppTextColor}"
                                               FontSize="14"
                                               TextWrapping="WrapWholeWords"
                                               Margin="0,6" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Sauvegardes du registre"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}" />
                            <TextBlock Text="{x:Bind ViewModel.RegistryBackupStatus, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{StaticResource AppSubtextColor}"
                                       TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Restaurer la dernière sauvegarde"
                                        Command="{x:Bind ViewModel.RestoreRegistryBackupCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                <Button Content="Ouvrir le dossier"
                                        Command="{x:Bind ViewModel.OpenRegistryBackupsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ DIAGNOSTICS ============ -->
            <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="860">
                    <TextBlock Text="Diagnostics"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextColor}" />
                    <TextBlock Text="Vérifie les droits et l'accès aux dossiers utilisés par le nettoyage."
                               FontSize="14"
                               Foreground="{StaticResource AppSubtextColor}"
                               TextWrapping="WrapWholeWords" />
                    <Button Content="Lancer les diagnostics"
                            Command="{x:Bind ViewModel.RunDiagnosticsCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Left" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <ListView ItemsSource="{x:Bind ViewModel.DiagnosticItems, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="440"
                                  HorizontalAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{x:Bind}"
                                               Foreground="{StaticResource AppTextColor}"
                                               FontSize="14"
                                               TextWrapping="WrapWholeWords"
                                               Margin="0,6" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ À PROPOS ============ -->
            <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="860">
                    <TextBlock Text="À propos"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextColor}" />

                    <Border Style="{StaticResource CardBorderStyle}" Padding="32,28">
                        <StackPanel Spacing="0" HorizontalAlignment="Center">
                            <Image Source="ms-appx:///Assets/panosse.png" Width="64" Height="64" Margin="0,0,0,16" />
                            <TextBlock Text="Panosse"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppPrimaryColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{x:Bind AppVersionText, Mode=OneWay}"
                                       FontSize="15"
                                       Foreground="{StaticResource AppMutedTextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18" />

                            <Button x:Name="AboutCheckUpdatesButton"
                                    Content="🔍 Vérifier les mises à jour"
                                    Click="AboutCheckUpdatesButton_Click"
                                    Style="{StaticResource AboutUpdateButtonStyle}"
                                    HorizontalAlignment="Center"
                                    MinWidth="240"
                                    Margin="0,0,0,8"
                                    IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.UpdatePhaseText, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{StaticResource AppTextColor}"
                                       TextWrapping="WrapWholeWords"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="AboutLastCheckText"
                                       Text="Dernière vérification : jamais"
                                       FontSize="13"
                                       Foreground="{StaticResource AppMutedTextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <StackPanel Spacing="8"
                                        HorizontalAlignment="Stretch"
                                        MaxWidth="360"
                                        Margin="0,0,0,12"
                                        Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                           FontSize="14"
                                           Foreground="{StaticResource AppSuccessColor}"
                                           TextWrapping="WrapWholeWords"
                                           TextAlignment="Center" />
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{x:Bind ViewModel.UpdateProgressValue, Mode=OneWay}"
                                             Height="6"
                                             Foreground="{StaticResource AppSuccessColor}"
                                             Background="{StaticResource AppBorderColor}"
                                             Visibility="{x:Bind ViewModel.IsUpdateProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="⬇️ Télécharger la mise à jour"
                                        Command="{x:Bind ViewModel.PrepareUpdateCommand}"
                                        Style="{StaticResource AboutUpdateButtonStyle}"
                                        HorizontalAlignment="Stretch" />
                                <Button Content="✅ Installer maintenant"
                                        Command="{x:Bind ViewModel.InstallPreparedUpdateCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind ViewModel.IsInstallReady, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Text="La serpillère numérique"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="pour un PC tout propre"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,22" />

                            <Border Height="1"
                                    Background="{StaticResource AppBorderColor}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,18" />

                            <TextBlock Text="Développé par"
                                       FontSize="14"
                                       Foreground="{StaticResource AppMutedTextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Marco Barbaro"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,14" />

                            <HyperlinkButton Content="🔗 GitHub"
                                             Click="AboutGithubButton_Click"
                                             HorizontalAlignment="Center"
                                             FontSize="14"
                                             Foreground="{StaticResource AppPrimaryColor}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
