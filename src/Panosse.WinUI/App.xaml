<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Panosse.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Panosse.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="BrandPrimaryColor">#FF2196F3</Color>
            <Color x:Key="BrandAccentColor">#FF42A5F5</Color>
            <Color x:Key="AppSurfaceColor">#FFE9EDF5</Color>
            <Color x:Key="AppTextColor">#FF111827</Color>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="AppSubtleBrush" Color="#FF1F2937" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE5EEFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF5B8DEF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF111827" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD4E3FF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF416FBF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF111827" />
            <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#FFEAF1FF" />
            <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="#FF2F6FD9" />
            <SolidColorBrush x:Key="ButtonForegroundFocused" Color="#FF0F172A" />

            <x:Double x:Key="Space4">4</x:Double>
            <x:Double x:Key="Space8">8</x:Double>
            <x:Double x:Key="Space12">12</x:Double>
            <x:Double x:Key="Space16">16</x:Double>
            <x:Double x:Key="Space24">24</x:Double>

            <x:Double x:Key="RadiusSmall">8</x:Double>
            <x:Double x:Key="RadiusMedium">12</x:Double>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppSubtleBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#FF1D7ECE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinWidth" Value="170" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="BorderBrush" Value="#FFD1D5DB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#FFD1D5DB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Padding" Value="24" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
